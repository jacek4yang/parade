{
  "name": "parade-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node node_modules/vite/bin/vite.js build",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src tests *.ts *.json *.html",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src tests *.ts *.json *.html",
    "lint": "node node_modules/eslint/bin/eslint.js src tests",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run --exclude tests/e2e/**",
    "test:e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.0",
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^24.2.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
